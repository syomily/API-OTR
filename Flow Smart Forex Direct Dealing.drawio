        <mxCell id="Vg0KkX_BgQTpV1ihWg15-8" value="&lt;font style=&quot;font-size: 6px;&quot;&gt;&lt;b&gt;Smart Forex&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;- Mengatur kurs valuta asing secara otomatis berbasis waktu dan volatilitas&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;- Dapat diatur manual jika diperlukan&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;- Menggunakan parameter (strategi pricing dan positioning)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;- Memiliki potensi integrasi dengan sistem eksternal (Xendit, Efi, PLN, Pertamina)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 6px;&quot;&gt;- Bertujuan meminimalkan intervensi manual, mempercepat update kurs, dan memvalidasi transaksi secara otomatis)&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
